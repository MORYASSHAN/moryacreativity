      "runtimeArgs": [
        "/c",
        "npm run dev -- --port %PORT% --strictPort"
      ],
      "port": 5189,
      "autoPort": true
    },
    {
      "name": "showcase",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "npm exec -- vite showcase --port %PORT% --strictPort"
      ],
